<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- 返回按钮 -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="返回"
                android:tint="@color/text_primary" />

            <!-- 分段控制器 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented_control"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_issued"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已发放"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp" />

                <TextView
                    android:id="@+id/tab_library"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="作业库"
                    android:textSize="14sp"
                    android:textColor="@color/primary_color"
                    android:background="@drawable/bg_tab_unselected"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="16dp" />

            </LinearLayout>

            <!-- 删除按钮 -->
            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="删除"
                android:tint="@color/text_primary" />

        </LinearLayout>

        <!-- 分界线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHomework"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"/>
            
        <!-- 创建作业菜单 -->
        <LinearLayout
            android:id="@+id/createMenuContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fabCreateHomework"
            android:layout_alignParentRight="true"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="0dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:visibility="gone">

            <!-- AI创建选项 -->
            <LinearLayout
                android:id="@+id/optionAiCreate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_menu_option"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:minWidth="120dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ai"
                    android:layout_marginEnd="8dp"
                    android:tint="@color/primary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI创建"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- 手动创建选项 -->
            <LinearLayout
                android:id="@+id/optionManualCreate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_menu_option"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:minWidth="120dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    android:layout_marginEnd="8dp"
                    android:tint="@color/primary_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手动创建"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- 批改作业按钮 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabReviewHomework"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_margin="16dp"
            android:src="@drawable/ic_edit"
            android:backgroundTint="@color/orange"
            android:contentDescription="前往批改"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCreateHomework"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add"
            android:backgroundTint="@color/primary_color"
            android:contentDescription="创建作业"/>
    </RelativeLayout>

</LinearLayout>