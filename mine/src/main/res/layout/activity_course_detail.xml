<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_gray">
<!--课程详情页，分为 顶部课程信息 + 历史课件列表 + 学习报告 三部分：-->
    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="4dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="返回按钮"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            app:tint="@color/black" />

        <!-- 标题文本 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="课程详情"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- 顶部课程信息 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:padding="20dp"
        android:background="@drawable/gradient_blue_bg" 
        android:elevation="8dp">

        <!-- 装饰元素 -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/circle_blur"
            android:alpha="0.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="20dp"
            android:translationX="20dp"/>
            
        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_blur"
            android:alpha="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- 课程图标 -->
        <ImageView
            android:id="@+id/iv_course_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/course_icon_bg"
            android:src="@drawable/ic_courses"
            android:scaleType="centerInside"
            android:elevation="2dp"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_upload_courseware"
            app:layout_constraintStart_toEndOf="@+id/iv_course_icon"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_course_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程名"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" 
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="1"/>

            <TextView
                android:id="@+id/tv_teacher_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="任课老师"
                android:textColor="#E3F2FD"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- 上传课件按钮 -->
        <TextView
            android:id="@+id/btn_upload_courseware"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_upload_bg"
            android:gravity="center"
            android:text="上传课件"
            android:textColor="@color/blue_600"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="visible"
            android:elevation="4dp"
            android:alpha="1.0"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 历史课件列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp" 
        android:layout_marginTop="16dp">
        
        <View 
            android:layout_width="4dp" 
            android:layout_height="24dp" 
            android:background="@color/blue_500"
            android:layout_marginEnd="8dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="历史课件"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/common_text_main_black"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCourseware"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" 
        android:clipToPadding="false"/>
        
    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>
        
    <!-- 学习报告 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp" 
        android:layout_marginTop="16dp">
        
        <View 
            android:layout_width="4dp" 
            android:layout_height="24dp" 
            android:background="@color/blue_500"
            android:layout_marginEnd="8dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学习报告"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/common_text_main_black"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        android:radius="12dp">
        <!--学习报告-->
        <TextView
            android:id="@+id/tv_total_study_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总学习时长：0小时" 
            android:textSize="15sp"
            android:textColor="@color/common_text_main_black"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_homework_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已完成作业：0/0" 
            android:textSize="15sp"
            android:textColor="@color/common_text_main_black"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_average_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="平均得分：0" 
            android:textSize="15sp"
            android:textColor="@color/common_text_main_black"/>

    </LinearLayout>

</LinearLayout>
