<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.jxdx.mine.teacherhomework.HomeworkDetailActivity">

    <!-- 作业详情顶部栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_color"
        android:paddingTop="10dp"
        app:title="作业详情"
        app:titleTextColor="@color/white"
        app:titleCentered="true"
        app:menu="@menu/menu_homework_detail"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white" />

    <!-- 加载状态布局 -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在加载作业详情..."
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- 错误状态布局 -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载失败，请重试"
            android:textSize="16sp"
            android:textColor="#FF6B6B"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>
        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重试"
            android:background="@drawable/shape_submit_button_background"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- 内容布局 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        
        <TextView
            android:id="@+id/tv_homework_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作业标题"
            android:textSize="20sp"
            android:textStyle="bold"/>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/tv_homework_id_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作业ID："
                android:textSize="14sp"
                android:textColor="#666666"/>
            <TextView
                android:id="@+id/tv_homework_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#666666"/>
            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tv_subject_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="科目："
                android:textSize="14sp"
                android:textColor="#666666"/>
            <TextView
                android:id="@+id/tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="科目名称"
                android:textSize="14sp"
                android:textColor="#666666"/>
        </LinearLayout>
        
        <TextView
            android:id="@+id/tv_homework_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作业描述"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
        
        <TextView
            android:id="@+id/tv_homework_due_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="截止日期"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"/>
            
        <!-- 作业图片列表 -->
        <TextView
            android:id="@+id/tv_images_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作业图片："
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewImages"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:paddingRight="8dp"/>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- 作业提交区域 -->
    <LinearLayout
        android:id="@+id/layout_submit_homework"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提交作业"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>
        
        <EditText
            android:id="@+id/et_student_content"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="请输入作业内容"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/shape_edittext_background"
            android:layout_marginBottom="12dp"/>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <Button
                android:id="@+id/btn_add_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加图片"
                android:background="@drawable/shape_button_background"/>
            
            <TextView
                android:id="@+id/tv_image_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:paddingRight="16dp"
                android:text="已选择0张图片"/>
        </LinearLayout>
        
        <!-- 已选图片预览 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSelectedImages"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>
        
        <Button
            android:id="@+id/btn_submit_homework"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提交作业"
            android:background="@drawable/shape_submit_button_background"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- 作业提交后的内容 -->
    <LinearLayout
        android:id="@+id/layout_submitted_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/tv_submitted_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已提交内容"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>
        
        <TextView
            android:id="@+id/tv_submitted_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        
        <TextView
            android:id="@+id/tv_submitted_images_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提交的图片："
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSubmittedImages"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>
        
        <!-- 批改信息（如果已批改） -->
        <LinearLayout
            android:id="@+id/layout_correction_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/shape_correction_background"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            
            <TextView
                android:id="@+id/tv_score_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分数："
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            
            <TextView
                android:id="@+id/tv_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="#FF6B6B"
                android:layout_marginBottom="12dp"/>
            
            <TextView
                android:id="@+id/tv_comment_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="评语："
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            
            <TextView
                android:id="@+id/tv_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 原始的提交列表RecyclerView（保持，但通常不会使用） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubmissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:visibility="gone"/>
    </LinearLayout>
    
    </ScrollView>

    <!-- 底部发布按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_publish_homework"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发布作业"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp" />

    </LinearLayout>
</LinearLayout>