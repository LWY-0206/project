<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主内容区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F9FAFB">

        <!-- 顶部工具栏 -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/purple_200"
            android:paddingHorizontal="35dp"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- 左侧头像按钮 -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/menu_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_default_avatar"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="头像按钮"
                    android:padding="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- 个人主页内容区域 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@android:color/transparent"
                android:showDividers="middle">

                <!-- 用户信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/edit_text_border"
                    android:elevation="3dp"
                    android:gravity="center_vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/user_avatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_default_avatar"
                        android:contentDescription="用户头像"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/black_alpha_30"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="学生姓名"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/user_grade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="高一（2）班"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/user_bio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="努力成为更好的自己"
                                android:textSize="14sp"
                                android:textColor="#666666"/>

                            <TextView
                                android:id="@+id/edit_user_bio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="编辑"
                                android:textSize="14sp"
                                android:textColor="@color/red_dark"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 学习成就 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="学习成就"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp">

                    <!-- 学习进度条 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本周任务完成进度69%"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="69"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_bar_style"
                        android:layout_marginVertical="8dp"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="总学习时长:"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:id="@+id/time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="   120h "
                            android:textStyle="italic"
                            android:textColor="@color/red_dark"
                            android:textSize="18sp" />
                    </LinearLayout>


                </LinearLayout>

                <!-- 学习动态 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="学习动态"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2小时前 完成了数学作业"
                        android:textSize="14sp"
                        android:textColor="#444444"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="昨天 参加了英语小测"
                        android:textSize="14sp"
                        android:textColor="#444444"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3天前 完成了物理实验报告"
                        android:textSize="14sp"
                        android:textColor="#444444"/>
                </LinearLayout>

                <!-- 学习时间分布柱状图 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="学习时间分布（小时/周）"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:elevation="2dp">

                    <WebView
                        android:id="@+id/barChartWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="底部"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>



    <!-- 侧边导航栏 -->
    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp">

        <!-- 顶部用户信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:gravity="center_vertical">

<!--            <ImageView-->
<!--                android:id="@+id/nav_avatar"-->
<!--                android:layout_width="30dp"-->
<!--                android:layout_height="30dp"-->
<!--                android:src="@drawable/ic_default_avatar"-->
<!--                android:background="@drawable/bg_circle"-->
<!--                android:scaleType="centerCrop"-->
<!--                android:contentDescription="用户头像"/>-->

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/nav_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerCrop"
                android:layout_gravity="center_vertical"
                android:contentDescription="头像" />

            <TextView
                android:id="@+id/nav_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="张三"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="12dp"/>

        <!-- 菜单选项 -->
        <LinearLayout
            android:id="@+id/nav_profile"
            style="@style/NavItemStyle">
            <ImageView android:src="@drawable/ic_profile" style="@style/NavItemIcon"/>
            <TextView android:text="个人主页" style="@style/NavItemText"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_points"
            style="@style/NavItemStyle">
            <ImageView android:src="@drawable/ic_points" style="@style/NavItemIcon"/>
            <TextView android:text="积分系统" style="@style/NavItemText"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_courses"
            style="@style/NavItemStyle">
            <ImageView android:src="@drawable/ic_courses" style="@style/NavItemIcon"/>
            <TextView android:text="课程" style="@style/NavItemText"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            style="@style/NavItemStyle">
            <ImageView android:src="@drawable/ic_settings" style="@style/NavItemIcon"/>
            <TextView android:text="作业" style="@style/NavItemText"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:id="@+id/nav_class"
            style="@style/NavItemStyle">
            <ImageView android:src="@drawable/ic_class" style="@style/NavItemIcon"/>
            <TextView android:text="我的班级" style="@style/NavItemText"/>
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
