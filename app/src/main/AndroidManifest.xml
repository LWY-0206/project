        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Loding" >
        <activity
            android:name=".activity.DynamicdetailsActivity"
            android:exported="true" />
        <activity
            android:name=".Home.My.EditProfileActivity"
            android:exported="false" /> <!-- 添加FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".homework.HomeworkActivity"
            android:exported="true" />
        <activity
            android:name=".Login.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".Login.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".Famous.FamousDetailActivity"
            android:exported="false" />
        <activity
            android:name=".Famous.FamousListActivity"
            android:exported="true" />
        <activity
            android:name=".Schools.SchoolDetailActivity"
            android:exported="true" />
        <activity
            android:name=".Schools.SchoolListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Questions.QuestionTypeSelectionActivity"
            android:exported="true" />
        <activity
            android:name=".Questions.ErrorQuizActivity"
            android:exported="true" />
        <activity
            android:name=".Home.Home"
            android:exported="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Home.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".Login.LoginActivity" />
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".webtest.UserTest"
            android:exported="true" />
        <activity
            android:name=".mytest.QuestionsAtivity"
            android:exported="false" />
        <activity
            android:name=".WebSocketTest.ConnectionActivity"
            android:exported="false" >
        </activity>
    </application>

</manifest>