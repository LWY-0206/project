<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景色：浅灰色 -->
    <solid android:color="@color/gray_100" />
    <!-- 圆角：8dp，让选项条看起来更柔和 -->
    <corners android:radius="8dp" />
    <!-- 边框：1dp浅灰，区分选项边界 -->
    <stroke
        android:width="1dp"
        android:color="@color/gray_200" />
</shape>