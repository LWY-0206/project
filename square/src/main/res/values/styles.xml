<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>
    
    <!-- 顶部标签栏文字样式 -->
    <style name="TabTextStyle" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    
    <!-- 校园主题样式 -->
    <style name="CampusTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/campus_blue</item>
        <item name="colorPrimaryDark">@color/campus_blue_dark</item>
        <item name="colorAccent">@color/campus_green</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
    
    <!-- 动态卡片样式 -->
    <style name="DynamicCardStyle">
        <item name="android:layout_margin">8dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:background">@drawable/card_bg</item>
    </style>
    
    <!-- 校园按钮样式 -->
    <style name="CampusButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/button_publish_bg</item>
        <item name="cornerRadius">18dp</item>
    </style>
    
</resources>