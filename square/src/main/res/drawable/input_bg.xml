<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景色：白色 -->
    <solid android:color="@android:color/white" />
    <!-- 圆角：8dp，让输入框看起来更柔和 -->
    <corners android:radius="8dp" />
    <!-- 边框：1dp浅灰色，区分输入框边界 -->
    <stroke
        android:width="1dp"
        android:color="@color/gray_200" />
</shape>