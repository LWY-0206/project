<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/beautiful_gradient_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 紧凑的顶部区域 -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient_new"
        android:elevation="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 标题和发布按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- 标题文字 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="校园动态"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif-medium" />

            <!-- 发布按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish_dynamic"
                style="@style/CampusButtonStyle"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:text="发布"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/modern_publish_button"
                android:paddingHorizontal="16dp"
                app:cornerRadius="18dp"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- 紧凑的搜索框容器 -->
        <LinearLayout
            android:id="@+id/ll_search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/floating_search_box"
            android:padding="12dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="10dp"
                app:tint="#2196F3" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="搜索动态..."
                android:textSize="14sp"
                android:textColorHint="#999999"
                android:background="@null"
                android:inputType="text"
                android:maxLines="1"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>

    <!-- 动态列表容器 - 占用更多空间 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_header">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_dynamics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:overScrollMode="never" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>