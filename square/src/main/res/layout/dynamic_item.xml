<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/card_bg"
    android:elevation="4dp"
    android:layout_margin="8dp">

    <!-- 用户信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 用户头像 -->
        <ImageView
            android:id="@+id/civ_user_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
             />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <!-- 用户名 -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户名"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <!-- 发布时间 -->
            <TextView
                android:id="@+id/tv_publish_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2小时前"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 动态内容 -->
    <TextView
        android:id="@+id/tv_dynamic_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="这里是动态的文字内容，展示用户发布的信息..."
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- 图片展示区域（最多3张） -->
    <LinearLayout
        android:id="@+id/ll_images_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <!-- 第一张图片 -->
        <ImageView
            android:id="@+id/iv_image_1"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray"
            android:layout_marginRight="8dp"
            android:adjustViewBounds="true" />

        <!-- 第二张图片 -->
        <ImageView
            android:id="@+id/iv_image_2"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            android:adjustViewBounds="true" />

        <!-- 第三张图片 -->
        <ImageView
            android:id="@+id/iv_image_3"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray"
            android:layout_marginLeft="8dp"
            android:visibility="gone"
            android:adjustViewBounds="true" />
    </LinearLayout>

    <!-- 互动按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:divider="@drawable/divider_vertical"
        android:showDividers="middle">

        <!-- 点赞按钮 -->
        <LinearLayout
            android:id="@+id/ll_like"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_like" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点赞"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- 打赏按钮 -->
        <LinearLayout
            android:id="@+id/ll_reward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_reward"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_reward" />

            <TextView
                android:id="@+id/tv_reward_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打赏"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- 评论按钮 -->
        <LinearLayout
            android:id="@+id/ll_comment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_comment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_comment" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评论"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第一条评论预览（如果有） -->
    <LinearLayout
        android:id="@+id/ll_first_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:padding="12dp"
        android:background="#f5f5f5">

        <TextView
            android:id="@+id/tv_comment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="评论用户：这是第一条评论的内容预览..."
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/tv_see_all_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看全部评论"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_light"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#f5f5f5"
        android:layout_marginTop="16dp" />
</LinearLayout>