<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/card_bg"
    android:elevation="6dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:stateListAnimator="@null">

    <!-- 用户信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 用户头像 -->
        <ImageView
            android:id="@+id/civ_user_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_avatar"
            android:background="@drawable/avatar_circle_bg"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <!-- 用户名 -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户名"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- 发布时间 -->
            <TextView
                android:id="@+id/tv_publish_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2小时前"
                android:textSize="13sp"
                android:textColor="@color/gray_500"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_time"
                android:drawablePadding="4dp"
                android:drawableTint="@color/gray_500" />
        </LinearLayout>
    </LinearLayout>

    <!-- 动态内容 -->
    <TextView
        android:id="@+id/tv_dynamic_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="这里是动态的文字内容，展示用户发布的信息..."
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="6dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.02" />

    <!-- 图片展示区域（最多3张） -->
    <LinearLayout
        android:id="@+id/ll_images_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        android:background="@drawable/images_container_bg"
        android:padding="8dp">

        <!-- 第一张图片 -->
        <ImageView
            android:id="@+id/iv_image_1"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_bg"
            android:layout_marginEnd="6dp"
            android:adjustViewBounds="true"
            android:foreground="@drawable/image_overlay" />

        <!-- 第二张图片 -->
        <ImageView
            android:id="@+id/iv_image_2"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_bg"
            android:layout_marginHorizontal="6dp"
            android:visibility="gone"
            android:adjustViewBounds="true"
            android:foreground="@drawable/image_overlay" />

        <!-- 第三张图片 -->
        <ImageView
            android:id="@+id/iv_image_3"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:src="@drawable/ic_image_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_bg"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            android:adjustViewBounds="true"
            android:foreground="@drawable/image_overlay" />
    </LinearLayout>

    <!-- 互动按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:layout_marginTop="22dp"
        android:background="@drawable/interaction_buttons_bg"
        android:padding="8dp"
        android:divider="@drawable/divider_vertical"
        android:showDividers="middle">

        <!-- 点赞按钮 -->
        <LinearLayout
            android:id="@+id/ll_like"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/button_interaction_bg"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_like"
                app:tint="@color/gray_600" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点赞"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 打赏按钮 -->
        <LinearLayout
            android:id="@+id/ll_reward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/button_interaction_bg"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_reward"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_reward"
                app:tint="#FF9800" />

            <TextView
                android:id="@+id/tv_reward_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打赏"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 评论按钮 -->
        <LinearLayout
            android:id="@+id/ll_comment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/button_interaction_bg"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_comment"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_comment"
                app:tint="@color/gray_600" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评论"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第一条评论预览（如果有） -->
    <LinearLayout
        android:id="@+id/ll_first_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        android:padding="16dp"
        android:background="@drawable/comment_preview_bg">

        <TextView
            android:id="@+id/tv_comment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="评论用户：这是第一条评论的内容预览..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tv_see_all_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看全部评论"
            android:textSize="14sp"
            android:textColor="#4A90E2"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="4dp" />
    </LinearLayout>
</LinearLayout>