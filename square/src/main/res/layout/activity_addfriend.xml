<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/modern_gradient_background"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:background="@drawable/header_gradient"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/back_button_bg_matching"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"
            android:padding="12dp"
            android:scaleType="centerInside"
            app:tint="#1976D2"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- 标题 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加好友"
            android:textSize="24sp"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:shadowColor="#1A000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- 占位，保持标题居中 -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 搜索框卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/card_gradient">

        <!-- 搜索提示文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="搜索用户"
            android:textSize="18sp"
            android:textColor="#424242"
            android:textStyle="bold"
            android:paddingBottom="16dp"
            android:drawableStart="@drawable/ic_search_small"
            android:drawablePadding="8dp"
            android:gravity="center_vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/search_box_focused"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:elevation="2dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="#2196F3"
                android:contentDescription="搜索" />

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="输入用户ID或昵称"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="normal" />
                
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                android:layout_marginStart="16dp">

                <Button
                    android:id="@+id/search_button"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/button_press_animation"
                    android:drawablePadding="6dp"
                    android:elevation="0dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null"
                    android:text="搜索"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 查询结果信息区域 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/user_info_gradient">

        <!-- 用户信息标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用户信息"
            android:textSize="20sp"
            android:textColor="#424242"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="10dp" />

        <!-- 圆形头像 -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="60dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/avatar_view"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:minWidth="80dp"
                android:minHeight="80dp"
                android:maxWidth="140dp"
                android:maxHeight="140dp"
                android:background="@drawable/enhanced_avatar_bg"
                android:scaleType="centerCrop" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 用户名 -->
        <TextView
            android:id="@+id/username_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用户名"
            android:textSize="24sp"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:letterSpacing="0.01"
            android:shadowColor="#1A000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- 用户ID -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:background="@drawable/enhanced_info_item_bg"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person"
                app:tint="#2196F3"
                android:contentDescription="用户ID" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户ID"
                android:textSize="15sp"
                android:textColor="#757575"
                android:textStyle="bold"
                android:paddingStart="12dp" />

            <TextView
                android:id="@+id/user_id_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="15sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:gravity="end" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 班级 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:background="@drawable/enhanced_info_item_bg"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_school"
                app:tint="#4CAF50"
                android:contentDescription="班级" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="班级"
                android:textSize="15sp"
                android:textColor="#757575"
                android:textStyle="bold"
                android:paddingStart="12dp" />

            <TextView
                android:id="@+id/class_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="15sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:gravity="end" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 身份 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:background="@drawable/enhanced_info_item_bg"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_badge"
                app:tint="#FF9800"
                android:contentDescription="身份" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="身份"
                android:textSize="15sp"
                android:textColor="#757575"
                android:textStyle="bold"
                android:paddingStart="12dp" />

            <TextView
                android:id="@+id/identity_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="15sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:gravity="end" />
        </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 发送好友申请按钮 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginTop="8dp">

        <Button
            android:id="@+id/send_request_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_ripple_primary"
            android:text="发送好友申请"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:drawableStart="@drawable/ic_add_friend"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:letterSpacing="0.01" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 加载状态 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center"
            android:background="@drawable/empty_state_bg">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_loading"
                android:contentDescription="加载中"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在搜索用户..."
                android:textSize="16sp"
                android:textColor="#757575"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 空状态 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center"
            android:background="@drawable/empty_state_bg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_empty_state"
                android:contentDescription="空状态"
                android:padding="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未找到用户"
                android:textSize="18sp"
                android:textColor="#424242"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请检查用户ID或昵称是否正确"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:paddingTop="8dp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 我的二维码按钮 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:shadowColor="#1A000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/qrcode_card_gradient">

        <Button
            android:id="@+id/my_qrcode_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/button_ripple_secondary"
            android:text="我的二维码"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:drawableStart="@drawable/ic_qrcode"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分享二维码让朋友快速添加您"
            android:textSize="13sp"
            android:textColor="#757575"
            android:gravity="center"
            android:paddingTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 占位，确保底部有空间 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp" />
</LinearLayout>

</ScrollView>
