<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".activity.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="屏幕推流演示"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- 当前RTMP服务器地址显示 -->
    <TextView
        android:id="@+id/tv_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RTMP服务器地址："
        android:padding="8dp"
        android:background="#f5f5f5"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="2" />

    <!-- 推流方式选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f0f0f0"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择推流方式："
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_group_stream_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_native_stream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Native推流"
                android:checked="true"
                android:layout_marginRight="16dp" />

            <RadioButton
                android:id="@+id/radio_ffmpeg_stream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FFmpeg推流" />

        </RadioGroup>
    </LinearLayout>

    <!-- 推流控制按钮 -->
    <Button
        android:id="@+id/btn_start_screen_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开始屏幕捕获"
        android:background="@color/colorPrimary"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_stop_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止推流"
        android:background="@color/colorAccent"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <!-- 推流状态显示 -->
    <TextView
        android:id="@+id/tv_stream_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="推流状态：未开始"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:textColor="#666666" />

</LinearLayout>