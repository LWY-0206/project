<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:padding="8dp"
    android:background="@drawable/item_selection_background">

    <!-- 主图片容器 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        android:background="@drawable/card_selection_background">

        <ImageView
            android:id="@+id/iv_resource_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/resource_item_background" />

    </androidx.cardview.widget.CardView>

    <!-- 资源名称 -->
    <TextView
        android:id="@+id/tv_resource_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:background="@drawable/resource_name_background"
        android:padding="8dp"
        android:text="资源名称"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 选择状态标识 - 右上角 -->
    <ImageView
        android:id="@+id/iv_selection_indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_selected_enhanced"
        android:background="@drawable/selection_indicator_background"
        android:padding="2dp"
        android:visibility="gone" />


</RelativeLayout>
