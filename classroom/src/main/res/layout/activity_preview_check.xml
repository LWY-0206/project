<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="预习查看"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center" />

        <!-- 添加任务按钮 -->
        <ImageButton
            android:id="@+id/btn_add_task"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_add"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="添加预习任务"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 统计信息栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E3F2FD"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_task_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总任务: 0 | 已完成: 0 | 完成率: 0%"
            android:textSize="14sp"
            android:textColor="#1976D2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_student_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总学生: 0 | 完成率≥80%: 0 | 平均完成率: 0%"
            android:textSize="14sp"
            android:textColor="#1976D2" />
    </LinearLayout>

    <!-- Tab切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="2dp">

        <RadioButton
            android:id="@+id/tab_preview_tasks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="预习任务"
            android:textSize="14sp"
            android:textColor="#1976D2"
            android:checked="true"
            android:background="@drawable/tab_selector"
            android:button="@null"
            android:gravity="center" />

        <RadioButton
            android:id="@+id/tab_student_preview"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="学生情况"
            android:textSize="14sp"
            android:textColor="#1976D2"
            android:background="@drawable/tab_selector"
            android:button="@null"
            android:gravity="center" />
    </LinearLayout>

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- 预习任务列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_preview_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- 学生预习情况列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_student_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
